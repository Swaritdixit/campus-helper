rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /items/{doc} {
      allow read, write: if request.auth != null;
    }

    match /matches/{doc} {
      allow read, write: if request.auth != null;
    }

    match /marketplace/{doc} {
      allow read, write: if request.auth != null;
    }

    match /Events/{doc} {
      allow read, write: if request.auth != null;
    }
		 match /pulse_polls/{doc} {
      allow read, write: if request.auth != null;
    }
     match /wellness_chats/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}